{
  "name": "@egig/ratchet",
  "version": "0.1.0",
  "description": "Model driven application framework: TypeScript models -> SQLite/Postgres schema, codegen, and composable pipelines.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "docs",
    "example"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ratchet": "./dist/cli/bin.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./core": "./dist/core/index.js",
    "./router": "./dist/router/index.js",
    "./server": "./dist/server/index.js",
    "./auth": "./dist/auth/index.js",
    "./auth/console-forms": "./dist/auth/console-forms.js",
    "./automation": "./dist/automation/index.js",
    "./workspace": "./dist/workspace/index.js",
    "./web": "./dist/web/index.js",
    "./web/router": "./dist/web/router.js",
    "./console": "./dist/console/index.js",
    "./console/client": "./dist/console/client/index.js",
    "./console/node": "./dist/console/node-assets.js",
    "./storage": "./dist/core/storage-config.js",
    "./storage/node": "./dist/core/storage-node.js",
    "./storage/s3": "./dist/core/storage-s3.js",
    "./storage/gcs": "./dist/core/storage-gcs.js",
    "./storage/azure": "./dist/core/storage-azure.js",
    "./workflows": "./dist/workflows/index.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p example/deploy/tsconfig.json",
    "test": "bun test",
    "cli": "cd example && bun ../src/cli/bin.ts",
    "serve": "cd example && bun ../src/cli/bin.ts serve",
    "docs:dev": "bun --cwd=docs run dev",
    "docs:build": "bun --cwd=docs run build",
    "docs:preview": "bun --cwd=docs run start"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@assistant-ui/react-data-stream": "^0.12.28",
    "@assistant-ui/react-markdown": "^0.14.13",
    "@flystorage/file-storage": "^1.2.2",
    "@flystorage/local-fs": "^1.2.0",
    "@heroicons/react": "^2.2.0",
    "@langchain/anthropic": "^1.5.8",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/openai": "^1.5.10",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-label": "^2.1.6",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-query": "^5.102.4",
    "@xyflow/react": "^12.11.6",
    "assistant-stream": "^0.3.40",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codejar": "^4.3.0",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.36.4",
    "inngest": "^4.20.0",
    "langchain": "^1.5.10",
    "postgres": "^3.4.5",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "turbo-stream": "^3",
    "uuidv7": "^1.0.2",
    "zod": "^4.5.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@azure/storage-blob": "^12.33.0",
    "@flystorage/aws-s3": "^1.2.0",
    "@flystorage/azure-storage-blob": "^1.2.0",
    "@flystorage/google-cloud-storage": "^1.2.0",
    "@google-cloud/storage": "^7.17.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "@flystorage/aws-s3": {
      "optional": true
    },
    "@flystorage/azure-storage-blob": {
      "optional": true
    },
    "@flystorage/google-cloud-storage": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@azure/storage-blob": "^12.33.0",
    "@flystorage/aws-s3": "^1.2.0",
    "@flystorage/azure-storage-blob": "^1.2.0",
    "@flystorage/google-cloud-storage": "^1.2.0",
    "@flystorage/in-memory": "^1.1.0",
    "@google-cloud/storage": "^7.17.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "typescript": "^5.7.2"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
